# ── Required ──────────────────────────────────────────────────────────────────
# Flask secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-string

# Flask environment (development | production)
FLASK_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite locally. Set to PostgreSQL URL for production.
# Render provides DATABASE_URL automatically when you add a PostgreSQL database.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ── AI API (optional) ─────────────────────────────────────────────────────────
# Providing an OpenAI-compatible API key enables personalised AI explanations.
# The platform works WITHOUT this key using the rule-based recommendation engine.
# NEVER commit a real API key to Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ── Rate limiting (optional) ──────────────────────────────────────────────────
# Leave empty to use in-memory storage. Set to Redis URL for persistent limits.
REDIS_URL=

# ── Email (optional) ──────────────────────────────────────────────────────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
